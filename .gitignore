# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (NEVER commit real keys or tokens)
.env
.env*.local
.env.production
!.env.example

# raw source video/art assets (optimized web copies live in public/assets/)
card video/
Before_the_Vow.mp3

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local backups, reports & screenshots
/backups/
/reports/
/screenshots/

# Part 2: Security & Privacy Guardrails (Strict Ignores)
# Database dumps & exports (preserve supabase/ migrations)
*.dump
*.sqlite
*.sqlite3
*.db
/data/
/exports/
/customer-data/
/guest-exports/
*.csv
*.xlsx
*.sql
!supabase/schema.sql
!supabase/auth_rls_hardening.sql

# Private keys, certificates & credentials
*.key
*.crt
*.cert
*.pfx
*.p12
*.keystore
id_rsa*
id_ed25519*

# Temporary scratch scripts & logs
/scratch/
/tmp/
/temp/
*.tmp
*.temp
*.log
*.swp
*~

